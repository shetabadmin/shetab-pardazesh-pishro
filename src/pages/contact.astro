---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="تماس با ما | شتاب پردازش پیشرو شاهرود"
  description="راه‌های ارتباط با شرکت شتاب پردازش پیشرو در شاهرود - تلفن: ۰۲۳-۳۲۲۲۵۰۹۵"
>
  <section class="page-header">
    <div class="container">
      <h1>تماس با ما</h1>
      <p>برای مشاوره رایگان، همین حالا با ما تماس بگیرید</p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container">

      <!-- دکمه‌های اصلی تماس -->
      <div class="quick-contact">
        <a href="tel:09122733136" class="quick-card quick-call">
          <div class="quick-icon">📞</div>
          <div class="quick-info">
            <span class="quick-label">تماس فوری</span>
            <strong>۰۹۱۲۲۷۳۳۱۳۶</strong>
          </div>
        </a>

        <a href="https://wa.me/989122733136?text=سلام%20،%20برای%20مشاوره%20رایگان%20تماس%20می‌گیرم" target="_blank" rel="noopener" class="quick-card quick-whatsapp">
          <div class="quick-icon">💬</div>
          <div class="quick-info">
            <span class="quick-label">واتساپ</span>
            <strong>ارسال پیام در واتساپ</strong>
          </div>
        </a>
      </div>

      <!-- اطلاعات تماس -->
      <div class="contact-grid">
        <div class="contact-info">
          <h2>اطلاعات تماس</h2>
          
          <div class="info-item">
            <span class="icon">📍</span>
            <div>
              <strong>آدرس</strong>
              <p>شاهرود، ابتدای خیابان ۲۲ بهمن، روبروی ساختمان پزشکان شفا</p>
            </div>
          </div>

          <div class="info-item">
            <span class="icon">📞</span>
            <div>
              <strong>تلفن ثابت</strong>
              <p><a href="tel:02332225095">۰۲۳۳۲۲۲۵۰۹۵</a></p>
            </div>
          </div>

          <div class="info-item">
            <span class="icon">📱</span>
            <div>
              <strong>تلفن همراه</strong>
              <p><a href="tel:09122733136">۰۹۱۲۲۷۳۳۱۳۶</a></p>
              <p><a href="tel:09358783136">۰۹۳۵۸۷۸۳۱۳۶</a></p>
            </div>
          </div>

          <div class="info-item">
            <span class="icon">🕐</span>
            <div>
              <strong>ساعات کاری</strong>
              <p>همه روزه به جز ایام تعطیل</p>
              <p>۹ الی ۱۳ و ۱۶ الی ۲۰</p>
            </div>
          </div>
        </div>

        <div class="whatsapp-box">
          <div class="wa-header">
            <span class="wa-icon">💬</span>
            <h2>مشاوره رایگان در واتساپ</h2>
          </div>
          <p class="wa-desc">
            سوالات خود را در واتساپ بپرسید. کارشناسان ما در اسرع وقت پاسخ می‌دهند.
            این سریع‌ترین راه ارتباط با ماست.
          </p>
          
          <div class="wa-features">
            <div class="wa-feature">
              <span>✓</span>
              <p>پاسخ سریع در ساعات کاری</p>
            </div>
            <div class="wa-feature">
              <span>✓</span>
              <p>مشاوره اولیه کاملاً رایگان</p>
            </div>
            <div class="wa-feature">
              <span>✓</span>
              <p>ارسال فایل و تصویر</p>
            </div>
            <div class="wa-feature">
              <span>✓</span>
              <p>بدون نیاز به تماس تلفنی</p>
            </div>
          </div>

          <a href="https://wa.me/989122733136?text=سلام%20،%20برای%20مشاوره%20رایگان%20تماس%20می‌گیرم" target="_blank" rel="noopener" class="wa-btn">
            <span>💬</span>
            <span>شروع گفتگو در واتساپ</span>
          </a>

          <div class="wa-numbers">
            <a href="https://wa.me/989122733136" target="_blank" rel="noopener">۰۹۱۲۲۷۳۳۱۳۶</a>
            <a href="https://wa.me/989358783136" target="_blank" rel="noopener">۰۹۳۵۸۷۸۳۱۳۶</a>
          </div>
        </div>
      </div>

      <!-- نقشه -->
      <div class="map-section">
        <h2>موقعیت ما روی نقشه</h2>
        <div class="map-container">
          <iframe 
            src="https://www.google.com/maps?q=36.4246332738126,54.967171636693585&hl=fa&z=17&output=embed" 
            width="100%" 
            height="400" 
            style="border:0; border-radius: 16px;" 
            allowfullscreen="" 
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
        <div class="map-actions">
          <a href="https://www.google.com/maps/dir/?api=1&destination=36.4246332738126,54.967171636693585" target="_blank" rel="noopener" class="map-btn">
            🧭 مسیریابی با گوگل مپ
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  /* هدر صفحه */
  .page-header {
    background: linear-gradient(135deg, #0f2557 0%, #1e3a8a 100%);
    color: #fff;
    padding: 70px 0;
    text-align: center;
  }
  .page-header h1 { color: #fff; }

  .contact-section { padding: 60px 0 80px; }

  /* ===== دکمه‌های سریع تماس ===== */
  .quick-contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 50px;
  }

  .quick-card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 25px 30px;
    border-radius: 18px;
    text-decoration: none;
    color: #fff;
    transition: all 0.3s;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    position: relative;
    overflow: hidden;
  }

  .quick-card::before {
    content: '';
    position: absolute;
    top: -50px;
    left: -50px;
    width: 150px;
    height: 150px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    transition: all 0.5s;
  }

  .quick-card:hover::before {
    transform: scale(1.5);
  }

  .quick-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
  }

  .quick-call {
    background: linear-gradient(135deg, #0f2557, #1e3a8a);
  }

  .quick-whatsapp {
    background: linear-gradient(135deg, #25D366, #128C7E);
  }

  .quick-icon {
    font-size: 2.5rem;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .quick-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    position: relative;
    z-index: 1;
  }

  .quick-label {
    font-size: 0.85rem;
    opacity: 0.9;
    font-weight: 500;
  }

  .quick-info strong {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.5px;
  }

  /* ===== گرید اطلاعات + واتساپ ===== */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-bottom: 60px;
  }

  .contact-info h2 { 
    color: #0f2557; 
    margin-bottom: 25px;
    font-size: 1.4rem;
  }

  .info-item {
    display: flex;
    gap: 15px;
    margin-bottom: 20px;
    padding: 20px;
    background: #f9fafb;
    border-radius: 12px;
    border-right: 4px solid #84cc16;
    transition: all 0.3s;
  }

  .info-item:hover {
    background: #fff;
    box-shadow: 0 8px 20px rgba(15, 37, 87, 0.08);
    transform: translateX(-3px);
  }

  .info-item .icon { font-size: 1.5rem; flex-shrink: 0; }
  .info-item strong { display: block; color: #0f2557; margin-bottom: 5px; }
  .info-item p { color: #4b5563; margin: 3px 0; }
  .info-item a { 
    color: #1e3a8a; 
    text-decoration: none; 
    font-weight: 700;
    transition: color 0.3s;
  }
  .info-item a:hover { color: #65a30d; }

  /* ===== باکس واتساپ ===== */
  .whatsapp-box {
    background: linear-gradient(135deg, #f0fdf4, #dcfce7);
    border: 2px solid #86efac;
    border-radius: 20px;
    padding: 35px 30px;
    display: flex;
    flex-direction: column;
  }

  .wa-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 15px;
  }

  .wa-icon {
    font-size: 2rem;
    background: #25D366;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .whatsapp-box h2 {
    color: #0f2557;
    font-size: 1.3rem;
    margin: 0;
  }

  .wa-desc {
    color: #4b5563;
    line-height: 1.9;
    margin-bottom: 20px;
    font-size: 0.95rem;
  }

  .wa-features {
    display: grid;
    gap: 10px;
    margin-bottom: 25px;
  }

  .wa-feature {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.92rem;
    color: #374151;
  }

  .wa-feature span {
    color: #25D366;
    font-weight: 900;
    font-size: 1.1rem;
  }

  .wa-feature p { margin: 0; }

  .wa-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: #25D366;
    color: #fff;
    padding: 16px 25px;
    border-radius: 14px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.05rem;
    transition: all 0.3s;
    box-shadow: 0 8px 20px rgba(37, 211, 102, 0.35);
    margin-bottom: 15px;
  }

  .wa-btn:hover {
    background: #128C7E;
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(37, 211, 102, 0.5);
  }

  .wa-numbers {
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
    padding-top: 15px;
    border-top: 1px dashed #86efac;
  }

  .wa-numbers a {
    color: #128C7E;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    transition: color 0.3s;
  }

  .wa-numbers a:hover { color: #25D366; }

  /* ===== نقشه ===== */
  .map-section h2 { 
    color: #0f2557; 
    margin-bottom: 25px; 
    text-align: center;
    font-size: 1.5rem;
  }

  .map-container {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(15, 37, 87, 0.1);
  }

  .map-actions {
    text-align: center;
    margin-top: 20px;
  }

  .map-btn {
    display: inline-block;
    background: #0f2557;
    color: #fff;
    padding: 12px 28px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    transition: all 0.3s;
  }

  .map-btn:hover {
    background: #1e3a8a;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(15, 37, 87, 0.3);
  }

  /* ===== ریسپانسیو ===== */
  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }

  @media (max-width: 768px) {
    .page-header { padding: 50px 0; }
    .page-header h1 { font-size: 1.8rem; }

    .contact-section { padding: 40px 0 60px; }

    .quick-contact {
      grid-template-columns: 1fr;
      gap: 15px;
      margin-bottom: 40px;
    }

    .quick-card {
      padding: 20px 22px;
    }

    .quick-icon { font-size: 2rem; }
    .quick-info strong { font-size: 1rem; }

    .whatsapp-box { padding: 25px 20px; }
    .whatsapp-box h2 { font-size: 1.1rem; }
    .wa-icon { width: 42px; height: 42px; font-size: 1.6rem; }
    .wa-btn { font-size: 0.95rem; padding: 14px 20px; }

    .map-section h2 { font-size: 1.2rem; }
  }
</style>